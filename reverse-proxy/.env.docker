# server configuration
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=6193
PATH_TO_SERVER_CONF=../server_conf.yml
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ORIGINS=http://localhost:6191,http://host.docker.internal:6191

# Logging configuration
LOG_LEVEL=trace
# default to "json" if not "plain"
LOG_FORMAT=plain
# can be set to 'console' or a file path
#LOG_PATH=/var/log/layer8
LOG_PATH=console
# leave empty if LOG_PATH is console
LOG_FILENAME=reverse-proxy.log

# Handler configuration
NTOR_SERVER_ID=http://10.10.10.102:6193
NTOR_STATIC_SECRET="this is 32-byte nTorStaticSecret"
JWT_VIRTUAL_CONNECTION_SECRET="this is 32-byte rp's jwt secret."
JWT_EXP_IN_HOURS=24
FORWARD_PROXY_URL=http://forward-proxy:6191
BACKEND_URL=http://host.docker.internal:3000

# TLS configuration
ENABLE_TLS=true
CA_PATH="./certs/mtls/ca.pem"
CERT_PATH="./certs/mtls/reverse-proxy.pem"
KEY_PATH="./certs/mtls/reverse-proxy.key"
