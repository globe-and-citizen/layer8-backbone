# Smoke test environment overrides for Reverse Proxy
# These override values from reverse-proxy/.env.docker for the Docker Compose smoke test

# Server
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=6193
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ORIGINS=http://localhost:6191

# Logging
LOG_LEVEL=info
LOG_FORMAT=plain
LOG_PATH=console
LOG_FILENAME=reverse-proxy.log

# Handler
# NTOR_SERVER_ID must match the backend_url used in the FP init-tunnel request
NTOR_SERVER_ID=https://reverse-proxy:6193
# Must be exactly 32 bytes (no surrounding quotes)
NTOR_STATIC_SECRET=this is 32-byte nTorStaticSecret
JWT_VIRTUAL_CONNECTION_SECRET=this is 32-byte rp's jwt secret.
JWT_EXP_IN_HOURS=24
FORWARD_PROXY_URL=http://forward-proxy:6191
# Point to spa-backend service on the compose network instead of host.docker.internal
BACKEND_URL=http://spa-backend:3000

# mTLS — paths inside the container volume (set alongside CA_SERVER_URL, CERT_NAME in compose)
ENABLE_TLS=true
CA_PATH=/certs/root_ca.crt
CERT_PATH=/certs/mtls.crt
KEY_PATH=/certs/mtls.key
