  "main": "e2e-test.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "smoke:up": "docker compose -f docker-compose.smoke.yml up --build -d",
    "smoke:down": "docker compose -f docker-compose.smoke.yml down -v",
    "smoke:logs": "docker compose -f docker-compose.smoke.yml logs --tail=50",
    "smoke:wait": "sh wait-for-services.sh",
    "smoke": "node smoke-test.js",
    "smoke:run": "npm run smoke:up && npm run smoke:wait && npm run smoke"
